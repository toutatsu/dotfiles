{
  "$schema": "https://opencode.ai/config.json",


  // 更新通知のみ受け取り、自動インストールはしない
  "autoupdate": "notify",

  // セッションの共有を無効化（手動で共有したい場合は "manual" に変更）
  "share": "disabled",

  // ユーザー名（セッション共有時などに表示される）
  // "username": "{env:USER}",


  // デフォルトで使用するモデル
  "model": "openai/gpt-4o",

  // 軽量タスク（コード補完・要約など）に使用するサブモデル
  // "small_model": "openai/gpt-4o-mini",

  // デフォルトエージェント（build / ask など）
  // "default_agent": "build",


  // ログレベル: DEBUG / INFO / WARN / ERROR
  "logLevel": "WARN",

  // 古いセッションデータの自動削除
  // "cleanupDays": 30,

  // ファイル変更のスナップショット（undo サポート）
  "snapshot": true,


  // 追加で読み込む指示ファイル（AGENTS.md や独自 markdown）
  // "instructions": ["./AGENTS.md"],


  // ツール出力の上限
  "tool_output": {
    // 最大行数（デフォルト: 2000）
    "max_lines": 2000,
    // 最大バイト数（デフォルト: 51200 = 50KB）
    "max_bytes": 51200
  },


  // コンテキスト自動圧縮
  "compaction": {
    // コンテキスト上限に近づいたら自動で圧縮
    "auto": true,
    // 不要な古いターンを削除して圧縮
    "prune": true,
    // 末尾から保持するターン数（最新の会話を残す）
    "tail_turns": 3
  },


  // プロバイダー設定
  "provider": {
    "openai": {
      "options": {
        // OPENAI_API_KEY 環境変数から API キーを読み込む
        "apiKey": "{env:OPENAI_API_KEY}",
        // OpenAI API のエンドポイント（デフォルト値）
        "baseURL": "https://api.openai.com/v1"
      },
      // 利用可能なモデル一覧
      "models": {
        "gpt-4o": {
          "name": "GPT-4o"
        },
        "gpt-4o-mini": {
          "name": "GPT-4o mini"
        },
        "o1": {
          "name": "o1"
        },
        "o3-mini": {
          "name": "o3-mini"
        }
      }
    },

    "llamacpp-local": {
      "name": "llama.cpp (Local)",
      "options": {
        "apiKey": "dummy"
        // ローカルサーバーを立てた場合は baseURL を指定
        // "baseURL": "http://localhost:8080/v1"
      },
      // 利用可能なモデル一覧
      "models": {
        "unsloth/gpt-oss-20b-GGUF:Q4_K_M": {
          "name": "gpt-oss:20B(local)"
        },
        "unsloth/gemma-4-31B-it-GGUF:Q4_K_M": {
          "name": "gemma4:31B(local)"
        },
        "unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M": {
          "name": "qwen3.6:35B(local)"
        },
        "unsloth/Qwen3.5-27B-GGUF:Q4_K_M": {
          "name": "qwen3.5:27B(local)"
        }
      }
    }
  }
}
