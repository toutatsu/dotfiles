#!/bin/bash
# ntfy サーバーへ Claude Code の通知を送信する
set -euo pipefail

# 接続先は ~/.config/ntfy-claude.env で設定する（テンプレート: ntfy-claude.env.example）
NTFY_CLAUDE_URL=""
NTFY_CLAUDE_AUTH=""
if [ -f "$HOME/.config/ntfy-claude.env" ]; then
  . "$HOME/.config/ntfy-claude.env"
fi

if [ -z "$NTFY_CLAUDE_URL" ]; then
  echo "ntfy-claude: NTFY_CLAUDE_URL が設定されていません。~/.config/ntfy-claude.env を作成してください。" >&2
  exit 1
fi

title="${1:-Claude Code}"
message="${2:-通知}"
priority="${3:-default}"
tags="${4:-bell}"
click="${5:-}"
actions="${6:-}"

headers=(
  -u "$NTFY_CLAUDE_AUTH"
  -H "Title: $title"
  -H "Priority: $priority"
  -H "Tags: $tags"
)

[ -n "$click" ] && headers+=(-H "Click: $click")
[ -n "$actions" ] && headers+=(-H "Actions: $actions")

curl -sk --max-time 5 "${headers[@]}" -d "$message" "$NTFY_CLAUDE_URL" > /dev/null
