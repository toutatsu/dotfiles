# opencode 環境変数テンプレート
# opencode.jsonc の {env:VAR_NAME} プレースホルダで参照される変数
#
# このファイルをコピーして ~/.config/opencode/.env を作成する
# cp config/opencode/.env.example ~/.config/opencode/.env


# =============================================================================
# AI プロバイダー API キー
# =============================================================================

# opencode.jsonc の provider.openai.options.apiKey で参照
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude モデルを使用する場合)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini モデルを使用する場合)
# GOOGLE_API_KEY=your_google_api_key_here


# =============================================================================
# MCP サーバー認証
# =============================================================================

# GitHub MCP サーバー (opencode.jsonc の mcp.github.headers で参照)
# GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here


# =============================================================================
# ローカル LLM サーバー
# =============================================================================

# llama.cpp サーバーのベース URL (opencode.jsonc の llamacpp-local プロバイダで使用)
# LLAMACPP_BASE_URL=http://localhost:8080/v1
