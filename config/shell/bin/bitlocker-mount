#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "使い方:"
    echo "  マウント:   $0 mount <デバイス> <マウントポイント> [-p <回復キー>]"
    echo "  アンマウント: $0 umount <マウントポイント>"
    echo ""
    echo "例:"
    echo "  $0 mount /dev/sdb2 /mnt/mydata"
    echo "  $0 mount /dev/sdb2 /mnt/mydata -p 123456-234567-345678-456789-567890-678901-789012-890123"
    echo "  $0 umount /mnt/mydata"
    echo ""
    echo "  ※ -p の値を省略すると回復キーを対話入力できる（シェル履歴に残らない）"
    exit 1
}

do_mount() {
    local device="$1"
    local mountpoint="$2"
    local recovery_key="${3:-}"
    local dislocker_dir="${mountpoint}-tmp"

    if [[ ! -b "$device" ]]; then
        echo "エラー: デバイス '$device' が見つかりません" >&2
        exit 1
    fi

    if mountpoint -q "$mountpoint" 2>/dev/null; then
        echo "エラー: '$mountpoint' はすでにマウントされています" >&2
        exit 1
    fi

    if [[ -d "$dislocker_dir" ]]; then
        echo "警告: '$dislocker_dir' が残っています。削除します"
        sudo rm -rf "$dislocker_dir"
    fi

    echo "マウントポイントを作成: $dislocker_dir, $mountpoint"
    sudo mkdir -p "$dislocker_dir" "$mountpoint"

    echo "BitLockerを解除中: $device -> $dislocker_dir"
    if [[ -n "$recovery_key" ]]; then
        sudo dislocker "$device" -p "$recovery_key" -- "$dislocker_dir"
    else
        sudo dislocker "$device" -u -- "$dislocker_dir"
    fi

    echo "ファイルシステムをマウント中: $dislocker_dir/dislocker-file -> $mountpoint"
    sudo mount -o loop,uid=$(id -u),gid=$(id -g) "$dislocker_dir/dislocker-file" "$mountpoint"

    echo "完了: $mountpoint にアクセスできます"
}

try_umount() {
    local target="$1"
    local err
    if err=$(sudo umount "$target" 2>&1); then
        return 0
    fi
    echo "警告: '$target' をアンマウントできませんでした" >&2
    echo "  原因: $err" >&2
    # busy の場合は使用中プロセスを表示する
    # lsof +D は配下を再帰走査して FUSE マウント等でハングするため使わない。
    # fuser -m はマウントポイント単位で即座に特定でき、暴走防止に timeout を付ける。
    if [[ "$err" == *busy* ]]; then
        echo "  使用中のプロセス:" >&2
        if command -v fuser >/dev/null 2>&1; then
            sudo timeout 10 fuser -vm "$target" 2>&1 | sed 's/^/    /' >&2 || true
        elif command -v lsof >/dev/null 2>&1; then
            sudo timeout 10 lsof "$target" 2>/dev/null | sed 's/^/    /' >&2 || true
        else
            echo "    （fuser / lsof が無いため特定できません）" >&2
        fi
    fi
    return 1
}

do_umount() {
    local mountpoint="$1"
    local dislocker_dir="${mountpoint}-tmp"

    # umount 前に物理デバイスを特定（BitLocker パーティションの親ディスク）
    # BitLocker デバイスが複数接続されている場合は誤った電源オフを避けるため特定しない
    local device="" parent_disks
    parent_disks=$(lsblk -rno FSTYPE,PKNAME | awk '$1=="BitLocker"{print $2}' | sort -u || true)
    if [[ -n "$parent_disks" && $(wc -l <<<"$parent_disks") -eq 1 ]]; then
        device="/dev/$parent_disks"
    fi

    local all_unmounted=true

    echo "アンマウント中: $mountpoint"
    if mountpoint -q "$mountpoint" 2>/dev/null || findmnt -n "$mountpoint" >/dev/null 2>&1; then
        try_umount "$mountpoint" || all_unmounted=false
    else
        echo "（すでにアンマウント済み）"
    fi

    echo "アンマウント中: $dislocker_dir"
    if findmnt -n "$dislocker_dir" >/dev/null 2>&1; then
        try_umount "$dislocker_dir" || all_unmounted=false
    else
        echo "（すでにアンマウント済み）"
    fi

    # アンマウントできなかった場合は dislocker_dir を消すとマウントが壊れるため残す
    if [[ "$all_unmounted" != true ]]; then
        echo "完了: アンマウントできなかったマウントポイントがあります（上記の原因を参照）" >&2
        return 1
    fi

    if [[ -d "$dislocker_dir" ]]; then
        sudo rm -rf "$dislocker_dir" && echo "削除: $dislocker_dir"
    fi

    echo "完了"

    # マウントが残っていなければ（=all_unmounted）、電源オフ（安全な取り外し）を選択可能にする
    if [[ -n "$device" && -b "$device" ]]; then
        read -r -p "デバイス $device の電源を切って安全に取り外しますか？ [y/N]: " answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            sudo udisksctl power-off -b "$device" && echo "電源オフ: $device（再使用には挿し直してください）"
        fi
    fi
}

# --- メイン ---

if [[ $# -lt 2 ]]; then
    usage
fi

subcommand="$1"
shift

case "$subcommand" in
    mount)
        if [[ $# -lt 2 ]]; then usage; fi
        device="$1"
        mountpoint="$2"
        shift 2
        recovery_key=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -p)
                    if [[ $# -ge 2 ]]; then
                        recovery_key="$2"
                        shift 2
                    else
                        read -rsp "回復キー: " recovery_key
                        echo
                        shift
                    fi
                    ;;
                *) echo "不明なオプション: $1" >&2; usage ;;
            esac
        done
        do_mount "$device" "$mountpoint" "$recovery_key"
        ;;
    umount|unmount)
        if [[ $# -lt 1 ]]; then usage; fi
        do_umount "$1"
        ;;
    *)
        echo "不明なコマンド: $subcommand" >&2
        usage
        ;;
esac
