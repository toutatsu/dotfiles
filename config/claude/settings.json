{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "skillListingMaxDescChars": 512,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-4-5-20251001"
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(make *)"
    ]
  },
  "model": "sonnet",
  "skillOverrides": {
    "update-config": "on",
    "keybindings-help": "on",
    "simplify": "on",
    "fewer-permission-prompts": "on",
    "loop": "on",
    "schedule": "on",
    "claude-api": "on",
    "superpowers:using-superpowers": "on",
    "superpowers:brainstorm": "on",
    "superpowers:brainstorming": "on",
    "superpowers:write-plan": "on",
    "superpowers:writing-plans": "on",
    "superpowers:execute-plan": "on",
    "superpowers:executing-plans": "on",
    "superpowers:systematic-debugging": "on",
    "superpowers:test-driven-development": "on",
    "superpowers:subagent-driven-development": "on",
    "superpowers:dispatching-parallel-agents": "on",
    "superpowers:using-git-worktrees": "on",
    "superpowers:finishing-a-development-branch": "on",
    "superpowers:writing-skills": "on",
    "superpowers:verification-before-completion": "on",
    "superpowers:requesting-code-review": "on",
    "superpowers:receiving-code-review": "on",
    "code-review:code-review": "on",
    "frontend-design:frontend-design": "on",
    "init": "on",
    "review": "on",
    "security-review": "on"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' '入力待ちです' --urgency=normal 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "language": "japanese",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "autoCompactWindow": 100000,
  "promptSuggestionEnabled": true,
  "tui": "fullscreen",
  "prefersReducedMotion": false,
  "showThinkingSummaries": false,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "todoFeatureEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "defaultView": "chat"
}
