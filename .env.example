# dotfiles 共通 環境変数テンプレート
# 各サービス固有の設定は config/<service>/.env.example を参照
#
# このファイルをコピーして ~/.env を作成し、各値を設定する
# cp .env.example ~/.env
# source ~/.env  # または ~/.profile / ~/.zshrc に追記


# =============================================================================
# エディタ / ツール
# =============================================================================

# デフォルトエディタ (vim / nvim / nano / code など)
EDITOR=vim

# デフォルトビジュアルエディタ (GUI エディタや TUI エディタなど)
# VISUAL=vim


# =============================================================================
# PATH 追加
# =============================================================================

# ユーザーローカルバイナリ（pip install --user, Claude Code など）
# export PATH="$HOME/.local/bin:$PATH"

# opencode CLI
# export PATH="$HOME/.opencode/bin:$PATH"

# npm グローバルバイナリ
# export PATH="$HOME/.npm-global/bin:$PATH"


# =============================================================================
# AI / LLM API キー
# =============================================================================

# Anthropic (Claude) — deepagents, claude-code など
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (ChatGPT, Codex) — opencode, deepagents など
OPENAI_API_KEY=your_openai_api_key_here

# Google (Gemini) — opencode など
# GOOGLE_API_KEY=your_google_api_key_here

# Mistral AI
# MISTRAL_API_KEY=your_mistral_api_key_here


# =============================================================================
# バージョン管理 / GitHub
# =============================================================================

# GitHub Personal Access Token — claude-code MCP, codex など
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Git ユーザー情報（グローバル設定の代わりに環境変数で渡す場合）
# GIT_AUTHOR_NAME="Your Name"
# GIT_AUTHOR_EMAIL="your@email.com"
# GIT_COMMITTER_NAME="Your Name"
# GIT_COMMITTER_EMAIL="your@email.com"


# =============================================================================
# SSH
# =============================================================================

# SSH エージェントソケット（通常は .profile が自動設定するので不要）
# SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
