#!/bin/bash
# ntfy サーバーへ Claude Code の通知を送信する
set -euo pipefail

# 接続先のデフォルト値。~/.config/ntfy-claude.env で上書きできる
# （テンプレート: ntfy-claude.env.example）
NTFY_CLAUDE_URL="https://ntfy.toutatsu.internal/claude"
NTFY_CLAUDE_AUTH="ntfy:ntfy"
[ -f "$HOME/.config/ntfy-claude.env" ] && . "$HOME/.config/ntfy-claude.env"

title="${1:-Claude Code}"
message="${2:-通知}"
priority="${3:-default}"
tags="${4:-bell}"
click="${5:-}"
actions="${6:-}"

headers=(
  -u "$NTFY_CLAUDE_AUTH"
  -H "Title: $title"
  -H "Priority: $priority"
  -H "Tags: $tags"
)

[ -n "$click" ] && headers+=(-H "Click: $click")
[ -n "$actions" ] && headers+=(-H "Actions: $actions")

curl -sk --max-time 5 "${headers[@]}" -d "$message" "$NTFY_CLAUDE_URL" > /dev/null
