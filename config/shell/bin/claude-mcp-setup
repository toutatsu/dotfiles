#!/bin/bash
# Claude Code MCP サーバー登録スクリプト
# ~/.env から GITHUB_PERSONAL_ACCESS_TOKEN を読み込み、既登録サーバーはスキップする
set -u

if [ -f "$HOME/.env" ]; then
  set -a
  . "$HOME/.env"
  set +a
fi

echo ""
echo "🔌 Claude Code MCP サーバー登録"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

registered=$(claude mcp list 2>/dev/null || true)

mcp_add() {
  local name="$1"
  local transport="$2"
  local url="$3"

  if echo "$registered" | grep -q "^${name}:"; then
    echo "  ⏭️  スキップ  $name (登録済み)"
    return
  fi

  echo "  🔗 登録中   $name"
  if claude mcp add --transport "$transport" "$name" "$url" 2>&1; then
    echo "  ✅ 登録完了 $name"
  else
    echo "  ❌ 失敗     $name"
  fi
}

# GitHub MCP（GITHUB_PERSONAL_ACCESS_TOKEN が必要）
if [ -z "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
  echo "  ⚠️  GITHUB_PERSONAL_ACCESS_TOKEN が未設定のため GitHub MCP をスキップします"
  echo "       ~/.env に設定後に再実行してください"
else
  mcp_add "github" "http" "https://api.githubcopilot.com/mcp/"
fi

echo ""
echo "登録済みサーバー一覧:"
claude mcp list 2>/dev/null | sed 's/^/  /'
echo ""
