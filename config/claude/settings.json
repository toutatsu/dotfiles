{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(make *)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "language": "japanese",
  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": false,
  "skillListingMaxDescChars": 512,
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' '入力待ちです' --urgency=normal 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "update-config": "on",
    "keybindings-help": "on",
    "simplify": "on",
    "fewer-permission-prompts": "on",
    "loop": "on",
    "schedule": "on",
    "claude-api": "on",
    "superpowers:brainstorm": "on",
    "superpowers:execute-plan": "on",
    "superpowers:write-plan": "on",
    "code-review:code-review": "on",
    "superpowers:subagent-driven-development": "on",
    "superpowers:finishing-a-development-branch": "on",
    "superpowers:dispatching-parallel-agents": "on",
    "superpowers:writing-skills": "on",
    "superpowers:verification-before-completion": "on",
    "superpowers:test-driven-development": "on",
    "superpowers:using-git-worktrees": "on",
    "superpowers:using-superpowers": "on",
    "superpowers:receiving-code-review": "on",
    "superpowers:writing-plans": "on",
    "superpowers:requesting-code-review": "on",
    "superpowers:brainstorming": "on",
    "superpowers:executing-plans": "on",
    "superpowers:systematic-debugging": "on",
    "frontend-design:frontend-design": "on",
    "init": "on",
    "review": "on",
    "security-review": "on"
  }
}
