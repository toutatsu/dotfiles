#!/bin/bash
# ファイルを ~/.Trash に移動する（rm の代替）
set -euo pipefail
if [ $# -eq 0 ]; then
  echo "使い方: trash <file>..." >&2
  exit 1
fi
mkdir -p "$HOME/.Trash"
failed=0
for f in "$@"; do
  if mv -i "$f" "$HOME/.Trash"; then
    echo "moved to ~/.Trash: $f"
  else
    failed=$((failed + 1))
  fi
done
[ "$failed" -eq 0 ] || exit 1
