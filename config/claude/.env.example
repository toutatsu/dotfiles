# Claude Code 環境変数テンプレート
# claude.json.example の YOUR_GITHUB_TOKEN などで参照される変数
#
# このファイルをコピーして ~/.env に追記するか、シェル設定で export する
# (Claude Code は ~/.claude.json のトークンを直接参照するため、
#  通常は claude mcp add コマンドで設定する)


# =============================================================================
# MCP サーバー認証
# =============================================================================

# GitHub MCP サーバー (claude.json.example の headers.Authorization で参照)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here


# =============================================================================
# API キー (直接 MCP サーバーに渡す場合)
# =============================================================================

# Anthropic (Claude Code 本体は ANTHROPIC_API_KEY を自動参照)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
