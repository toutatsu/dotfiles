{
  // OpenClaw 設定ファイルテンプレート
  // 実際の設定は ~/.openclaw/openclaw.json に配置する（シンボリックリンク非対象）
  // セットアップ: openclaw onboard --install-daemon
  // 検証:        openclaw doctor
  // スキーマ確認: openclaw config schema

  "agents": {
    "defaults": {
      "workspace": "/home/YOUR_USERNAME/.openclaw/workspace",

      // 使用可能なモデル一覧（claude-cli プロバイダー経由）
      "models": {
        "claude-cli/claude-opus-4-7": {},
        "claude-cli/claude-sonnet-4-6": {},
        "claude-cli/claude-haiku-4-5": {}
      },

      // プライマリモデルとフォールバック
      "model": {
        "primary": "claude-cli/claude-sonnet-4-6",
        "fallbacks": ["claude-cli/claude-haiku-4-5"]
      },

      // コンテキスト制限
      "contextLimits": {
        "memoryGetMaxChars": 20000,
        "toolResultMaxChars": 40000
      },

      // コンテキスト圧縮（長いセッションでのトークン節約）
      "compaction": {
        "keepRecentTokens": 8000
      }
    }
  },

  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "YOUR_GATEWAY_TOKEN"
    },
    "port": 18789,
    // loopback: ローカル接続のみ（推奨）。"all" にすると LAN 全体に公開
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    // 危険なノードコマンドをデフォルト無効化
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },

  "session": {
    // per-channel-peer: チャネルとペアの組み合わせごとにセッションを分離
    "dmScope": "per-channel-peer"
  },

  "tools": {
    // プロファイル: "coding" | "general" | "minimal"
    "profile": "coding",
    "web": {
      "search": {
        "provider": "ollama",
        "enabled": true
      }
    }
  },

  "auth": {
    "profiles": {
      "anthropic:claude-cli": {
        "provider": "claude-cli",
        "mode": "oauth"
      }
    }
  },

  "plugins": {
    "entries": {
      "ollama": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      }
    }
  },

  "skills": {
    "install": {
      // パッケージマネージャ: "npm" | "yarn" | "pnpm" | "bun"
      "nodeManager": "npm"
    }
  },

  // 自動更新チャネル: "stable" | "beta" | "dev"
  "update": {
    "channel": "stable"
  },

  "logging": {
    "level": "info",
    // ログファイルに保存する場合は以下を有効化
    // "file": "~/.openclaw/logs/gateway.log"
    "redact": {
      "enabled": true
    }
  }
}
