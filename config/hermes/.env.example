# ~/.hermes/.env
# Hermes Agent API キー設定テンプレート
# このファイルをコピーして ~/.hermes/.env に配置し、各キーを設定すること
# $ cp config/hermes/.env.example ~/.hermes/.env

# ---------------------------------------------------------------------------
# LLM プロバイダ
# ---------------------------------------------------------------------------

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# OpenRouter (複数プロバイダを束ねる)
# OPENROUTER_API_KEY=sk-or-...

# Google (Gemini)
# GOOGLE_API_KEY=...

# Groq (高速推論)
# GROQ_API_KEY=gsk_...

# Together AI
# TOGETHER_API_KEY=...

# ---------------------------------------------------------------------------
# メッセージング統合
# ---------------------------------------------------------------------------

# Discord
# DISCORD_BOT_TOKEN=...
# DISCORD_ALLOWED_USERS=123456789

# Telegram
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USERS=123456789

# Slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# ---------------------------------------------------------------------------
# メモリプロバイダ (memory.provider を設定した場合のみ必要)
# ---------------------------------------------------------------------------

# ByteRover (クラウド同期)
# BRV_API_KEY=...

# Mem0
# MEM0_API_KEY=...

# GitHub Personal Access Token (MCP サーバー用)
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# ---------------------------------------------------------------------------
# 音声モード
# ---------------------------------------------------------------------------

# ElevenLabs TTS (プレミアム品質)
# ELEVENLABS_API_KEY=...

# OpenAI TTS / Whisper STT
# VOICE_TOOLS_OPENAI_KEY=sk-...
