# 共通環境変数テンプレート（マスター）
# ~/.env にコピーして各値を設定する
# .profile の `set -a; . ~/.env` により全シェルセッションで自動 export される
#
# bootstrap.sh がこのファイルをもとにツール固有 .env を生成するため、
# 必要な変数をここに集約する

# =============================================================================
# AI プロバイダー API キー
# =============================================================================

# Anthropic (Claude Code / hermes / deepagents / opencode で使用)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (opencode / codex / deepagents / hermes で使用)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (opencode / hermes で使用)
# GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq
# GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# MCP サーバー認証
# =============================================================================

# GitHub (claude-mcp-setup / opencode / codex / hermes で使用)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# =============================================================================
# ntfy-claude 通知設定
# =============================================================================

# ntfy サーバーへの通知 URL (~/.config/ntfy-claude.env に分離して使用)
# NTFY_CLAUDE_URL=https://ntfy.example.internal/claude
# NTFY_CLAUDE_AUTH=user:password
